{
  "expo": {
    "name": "SaborExpress",
    "slug": "saborexpress",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "saborexpress",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.yersonct.saborexpress"
    },
    "android": {
      "softwareKeyboardLayoutMode": "resize",
      "package": "com.yersonct.saborexpress",
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "android.permission.VIBRATE",
        "android.permission.BLUETOOTH_SCAN",
        "android.permission.BLUETOOTH_CONNECT",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.CAMERA",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#0B1220",
        "foregroundImage": "./assets/images/adaptive-icon.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "@sfourdrinier/react-native-ble-plx",
        {
          "isBackgroundEnabled": false,
          "neverForLocation": true
        }
      ],
      "expo-notifications",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0B1220",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 220
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Permitir que SaborExpress acceda a tu cámara para escanear QR.",
          "recordAudioAndroid": false
        }
      ],
      "expo-secure-store",
      [
        "expo-audio",
        {
          "recordAudioAndroid": false
        }
      ],
      "expo-font",
      "expo-image",
      "expo-web-browser",
      "expo-status-bar",
      "expo-asset",
      "expo-sharing",
      [
        "@ricka7x/expo-thermal-printer",
        {
          "bluetoothPermission": "SaborExpress necesita Bluetooth para imprimir recibos."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "7df6fc8c-c880-420e-a147-45723633724c"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/7df6fc8c-c880-420e-a147-45723633724c"
    }
  }
}
